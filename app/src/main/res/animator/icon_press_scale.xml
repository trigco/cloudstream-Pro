<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 5A: press feedback for the floating top bar icon buttons.
     Referenced via android:stateListAnimator (attribute already used in styles.xml;
     objectAnimator vocabulary follows the project's animated-vector drawables).
     valueTo-only on purpose: each state animates from the CURRENT scale, so the
     default state never forces a wrong start value when the animator attaches. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator
                android:duration="90"
                android:propertyName="scaleX"
                android:valueTo="0.88"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="90"
                android:propertyName="scaleY"
                android:valueTo="0.88"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
