<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.85: one page of the compact Feed hero carousel —
     poster fills the card, bottom gradient scrim, title +
     provider/type line bottom-left.
     Phase 8.90: his screenshot showed the portrait poster
     center-cropped into the landscape frame (faces sliced, the
     "epic" logo giant) — SearchResponse carries no landscape
     backdrop field (only LoadResponse does), so the page now
     uses the premium two-layer treatment: the same poster,
     heavily downsampled + darkened (+ a real RenderEffect blur
     on API 31+), fills the frame as a backdrop, and the sharp
     poster itself sits CONTAINED (fitCenter) on top of it.
     Nothing is cropped away anymore. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/feed_hero_backdrop_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.65"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <ImageView
        android:id="@+id/feed_hero_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_feed_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/feed_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#B0000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/feed_hero_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFCCCCCC"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
