<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/feed_watch_player_box"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/feed_watch_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/feed_watch_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="zoom"
            app:show_buffering="never"
            app:use_controller="false" />

        <LinearLayout
            android:id="@+id/feed_watch_loading_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/feed_watch_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/feed_watch_source_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FFDDDDDD"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feed_watch_error_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/feed_watch_open_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feed_open_details" />

            <Button
                android:id="@+id/feed_watch_play_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/feed_play_main"
                android:visibility="gone" />

            <Button
                android:id="@+id/feed_watch_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/feed_retry" />
        </LinearLayout>

        <!-- 8.70: the main player's YouTube-style seek wedge (8.62),
             ported to the feed player — replaces the old skip badges. -->
        <FrameLayout
            android:id="@+id/feed_seek_fx_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <View
                android:layout_width="300dp"
                android:layout_height="560dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="-150dp"
                android:background="@drawable/seek_wedge_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="36dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:scaleX="-1"
                    android:src="@drawable/ic_seek_triangles"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/feed_seek_fx_left_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/feed_seek_fx_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <View
                android:layout_width="300dp"
                android:layout_height="560dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="-150dp"
                android:background="@drawable/seek_wedge_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="36dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_seek_triangles"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/feed_seek_fx_right_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/feed_watch_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:orientation="horizontal"
                android:padding="4dp">

                <androidx.mediarouter.app.MediaRouteButton
                    android:id="@+id/feed_watch_cast"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/feed_center_button_bg"
                    android:mediaRouteTypes="user"
                    android:visibility="gone"
                    app:mediaRouteButtonTint="?attr/textColor" />

                <ImageButton
                    android:id="@+id/feed_watch_audio"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/feed_center_button_bg"
                    android:contentDescription="@string/feed_audio"
                    android:padding="10dp"
                    android:src="@drawable/feed_audio" />

                <ImageButton
                    android:id="@+id/feed_watch_subtitles"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/feed_center_button_bg"
                    android:contentDescription="@string/feed_subtitles"
                    android:padding="10dp"
                    android:src="@drawable/ic_baseline_subtitles_24" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/feed_watch_play_pause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/feed_center_button_bg"
                android:contentDescription="@string/feed_play_pause"
                android:padding="16dp"
                android:src="@drawable/netflix_pause" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/feed_controls_bar_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/feed_watch_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:text="0:00" />

                <SeekBar
                    android:id="@+id/feed_watch_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressBackgroundTint="@color/videoBuffered"
                    android:progressTint="@color/colorPrimaryRed"
                    android:thumbTint="@color/colorPrimaryRed" />

                <TextView
                    android:id="@+id/feed_watch_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:text="0:00" />

                <ImageButton
                    android:id="@+id/feed_watch_fullscreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/feed_center_button_bg"
                    android:contentDescription="@string/feed_fullscreen"
                    android:src="@drawable/baseline_fullscreen_24" />

                <ImageButton
                    android:id="@+id/feed_watch_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/feed_next_episode"
                    android:src="@drawable/ic_baseline_skip_next_24"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Phase 8.97: brightness/volume swipe indicators —
             the MAIN PLAYER's side rails, mirrored (his order:
             the 8.92 centred dark box — sun + "60%" + thick
             bar — is rejected). PlayerGestureHelper /
             player_custom_layout.xml present each value as a
             slim, transparent holder at the video's side: an
             icon over a 5dp-wide vertical ProgressBar drawn
             with @drawable/progress_drawable_vertical (white
             fill on a translucent track), max 100_000 for
             smoothness, fading out after 1.5 s. Phase 8.98:
             the rail stands on the side OPPOSITE its gesture
             zone (his order — the gesturing hand covered the
             rail on its own side): the brightness holder
             (id feed_gesture_left, fed by the left zone) sits
             on the RIGHT edge, the volume holder on the LEFT. -->
        <LinearLayout
            android:id="@+id/feed_gesture_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/feed_gesture_left_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/feed_gesture_left_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/feed_gesture_left_bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="5dp"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="100000"
                android:progressDrawable="@drawable/progress_drawable_vertical"
                android:progressTint="@color/white"
                android:progressTintMode="src_in" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feed_gesture_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/feed_gesture_right_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/feed_gesture_right_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/feed_gesture_right_bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="5dp"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="100000"
                android:progressDrawable="@drawable/progress_drawable_vertical"
                android:progressTint="@color/white"
                android:progressTintMode="src_in" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/feed_watch_title_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/feed_watch_player_box">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/feed_watch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@id/feed_watch_more"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Phase 8.85: the Info toggle was a compact pill
                 chip packed after the title (ⓘ + "Info" on a
                 filled background). Phase 8.93: tapping it opens
                 the FeedInfoSheet (description / cast / trailer).
                 Phase 8.97 (his order): NOT a button — clean
                 tappable TEXT, the word "Info" + a small
                 right-pointing chevron (›, a muted-grey vector,
                 ic_feed_chevron_right — his amendment: the
                 reference app's "Info ›", not a downward
                 chevron, not a text glyph). No background, no
                 icon circle; the padding + 40dp minHeight keep
                 the touch area generous. -->
            <TextView
                android:id="@+id/feed_watch_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawablePadding="2dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/feed_info"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone"
                app:drawableEndCompat="@drawable/ic_feed_chevron_right"
                app:layout_constraintBottom_toBottomOf="@id/feed_watch_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/feed_watch_title"
                app:layout_constraintTop_toTopOf="@id/feed_watch_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/feed_watch_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/grayTextColor"
            android:textSize="12sp" />

        <!-- Phase 8.93: the inline storyline TextView is gone —
             the plot now lives in the FeedInfoSheet opened by the
             Info pill above. -->

        <!-- 8.71: one-line pill row, natural widths inside a
             HorizontalScrollView — four pills never squeeze or
             truncate their labels on narrow phones; the row simply
             swipes a little when it overflows. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/feed_watch_source_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/feed_pill_bg"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/feed_sources"
                    android:src="@drawable/ic_baseline_dns_24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/feed_sources"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/feed_watch_episodes_btn"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/feed_pill_bg"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/episodes"
                    android:src="@drawable/baseline_list_alt_24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/episodes"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/feed_watch_download_btn"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/feed_pill_bg"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ProgressBar
                    android:id="@+id/feed_watch_download_progress"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/feed_watch_download_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/download"
                    android:src="@drawable/ic_feed_download" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/download"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Phase 8.71: Add to list moves INTO the pill row — all
                 four actions on one line (his request); the row was
                 previously three wide pills + this one alone below. -->
            <LinearLayout
                android:id="@+id/feed_watch_list_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/feed_pill_bg"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/add_to_list"
                    android:src="@drawable/ic_baseline_bookmark_24" />

                <TextView
                    android:id="@+id/feed_watch_list_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/add_to_list"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        </HorizontalScrollView>

        <!-- Phase 8.73: "For You" section header with a red underline
             bar (his suggestion) — reads as a deliberate header
             instead of a floating label with dead space under the
             pills; top margin tightened 18dp -> 10dp. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/feed_watch_upnext_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/feed_for_you"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="34dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/colorPrimaryRed" />
        </LinearLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/feed_watch_upnext_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/feed_watch_title_box">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/feed_watch_upnext"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ImageButton
        android:id="@+id/feed_watch_to_top"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/feed_center_button_bg"
        android:contentDescription="@string/feed_back_to_top"
        android:padding="10dp"
        android:src="@drawable/round_keyboard_arrow_up_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
