<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.85: the Feed page, Explore-style (SkyStream reference):
     a top bar (page title + circular filter/search buttons) joins
     the genre chips in the floating header; the grid below is
     3 columns like Home's. The header overlays the grid and
     hides by sliding up (Phase 8.23).
     Phase 8.92: the hero is REMOVED entirely (his verdict —
     unstable, odd shadow); the grid's ConcatAdapter is now
     category rows + cards.
     Phase 8.96: the ConcatAdapter is skeleton rows (while the
     chrome pass runs) + category rows + cards, and the header
     search button pushes the FEED-scoped search page
     (navigation_feed_search, FeedSearchFragment). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/feed_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/feed_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="80dp" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/feed_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Phase 8.96: the loading skeleton mirrors
                         the final page's structure — category
                         rows first (same mirror layout the
                         in-list skeleton rows use), then the
                         For You poster grid. -->
                    <include layout="@layout/feed_category_row_skeleton" />

                    <include layout="@layout/feed_category_row_skeleton" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            layout="@layout/feed_skeleton_item"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:layout_weight="1" />

                        <include
                            layout="@layout/feed_skeleton_item"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:layout_weight="1" />

                        <include
                            layout="@layout/feed_skeleton_item"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:layout_weight="1" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            layout="@layout/feed_skeleton_item"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:layout_weight="1" />

                        <include
                            layout="@layout/feed_skeleton_item"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:layout_weight="1" />

                        <include
                            layout="@layout/feed_skeleton_item"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:layout_weight="1" />

                    </LinearLayout>

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

            <ProgressBar
                android:id="@+id/feed_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/feed_empty_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:contentDescription="@null"
                    android:src="@drawable/feed_empty_art" />

                <TextView
                    android:id="@+id/feed_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:text="@string/feed_empty"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/feed_empty_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/feed_search_bg"
                    android:paddingStart="22dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="9dp"
                    android:text="@string/feed_show_all"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Phase 8.92: no hero lives here anymore — it was removed
         from the Feed entirely (his verdict). The grid's first
         list items are the category rows. -->

    <LinearLayout
        android:id="@+id/feed_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        android:elevation="6dp"
        android:orientation="vertical">

        <!-- Phase 8.85: Explore-style top bar — page title at the
             left, circular filter + search buttons at the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/feed_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/feed_title"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/feed_filter_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_feed_circle_button"
                android:contentDescription="@string/feed_filter_open"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_baseline_tune_24"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/feed_search_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_feed_circle_button"
                android:contentDescription="@string/search"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/search_icon"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Phase 8.94 (Job 3): the 8.92 in-feed search row is
             removed — the header's search button now pushes the
             standalone Search page (navigation_feed_search) over
             the Feed. Settled behaviour, his final word
             2026-10-30: not a tab switch, not an expanding row. -->

        <!-- Phase 8.96: the chips live in a FrameLayout so the
             chips SKELETON can overlay them while the chrome
             pass runs. The real chips view stays in the layout
             (INVISIBLE, not gone, while the skeleton shows), so
             the floating header's measured height — and with it
             the grid's top padding — never changes across the
             skeleton → real swap. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/feed_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/feed_chips_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/feed_skeleton_pill" />

                    <View
                        android:layout_width="86dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/feed_skeleton_pill" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/feed_skeleton_pill" />

                    <View
                        android:layout_width="98dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/feed_skeleton_pill" />

                    <View
                        android:layout_width="62dp"
                        android:layout_height="34dp"
                        android:background="@drawable/feed_skeleton_pill" />

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

        <!-- Phase 8.85: the "For You" header (red underline, 8.73
             treatment) moves into the page flow above the grid —
             it used to exist only on the watch screen. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/feed_for_you"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="34dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/colorPrimaryRed" />
        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/feed_mini"
        layout="@layout/feed_mini_player" />

</FrameLayout>
