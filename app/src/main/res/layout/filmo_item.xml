<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.93: one filmography grid cell (Actor page): poster on
     top, title under it, then a muted year / character line. Used
     for TVmaze entries (with poster) and Wikidata-only entries
     (poster area shows the title's initials instead). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:background="@drawable/feed_skeleton_poster">

        <TextView
            android:id="@+id/filmo_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/grayTextColor"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/filmo_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/filmo_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        tools:text="The Intouchables" />

    <TextView
        android:id="@+id/filmo_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/grayTextColor"
        android:textSize="11sp"
        tools:text="2011 • Assane Diop" />
</LinearLayout>
