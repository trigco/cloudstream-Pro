<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.88: the Feed's Categories section as a list item in
     the grid's ConcatAdapter, directly under the hero header:
     a "Categories" heading (same treatment as the page's For You
     header) over a horizontal scroll of smart-category tiles.
     Tiles are built in code by FeedCategoriesAdapter, like the
     genre chips above them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="2dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/home_custom_categories_row"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:layout_width="34dp"
        android:layout_height="3dp"
        android:layout_marginTop="4dp"
        android:background="@color/colorPrimaryRed" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/feed_categories_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="16dp" />

    </HorizontalScrollView>

</LinearLayout>
