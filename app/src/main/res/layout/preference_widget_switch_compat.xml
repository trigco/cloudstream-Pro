<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.75: app-level override of the preference library's
     switch widget layout (same resource name wins over the AAR's).
     The library default is a bare SwitchCompat with no styling,
     which is why the player/general/UI settings screens kept the
     old gray switch while the rest of the app moved on. This one
     renders a MaterialSwitch — Google's M3 switch with the thumb
     animation — in his reference colours (light-blue track, deep-
     blue thumb when ON). SwitchPreferenceCompat looks the widget up
     by this exact id and type; MaterialSwitch is a SwitchCompat
     subclass, so the binding contract is unchanged. -->
<com.google.android.material.materialswitch.MaterialSwitch
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switchWidget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:focusable="false"
    app:thumbTint="@color/switch_thumb_tint"
    app:trackTint="@color/switch_track_tint" />
