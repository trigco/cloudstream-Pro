<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.20: one skeleton placeholder card, mirroring feed_card's
     proportions (2:3 poster block + title bar + meta bar). -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="?attr/primaryGrayBackground"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/skeleton_poster"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/feed_skeleton_poster"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/feed_skeleton_circle"
            app:layout_constraintBottom_toBottomOf="@id/skeleton_poster"
            app:layout_constraintEnd_toEndOf="@id/skeleton_poster" />

        <View
            android:id="@+id/skeleton_title"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/feed_skeleton_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_poster" />

        <View
            android:layout_width="0dp"
            android:layout_height="9dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="70dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/feed_skeleton_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
