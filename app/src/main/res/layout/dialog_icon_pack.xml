<?xml version="1.0" encoding="utf-8"?>
<!-- App icon picker (Phase 8.11-F): five tappable launcher-icon
     previews. Shown in a BottomSheetDialog from SettingsUI; the sheet
     surface itself comes from the bottomSheetDialogTheme
     (rounded_dialog via AppModalStyle), so no background here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- Phase 8.89: standard sheet chrome (Feed Filters reference). -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_feed_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_icon_settings"
            android:textColor="?attr/textColor"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/close_btt"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_feed_circle_button"
            android:contentDescription="@string/switcher_close"
            android:padding="9dp"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="?attr/textColor" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="3">

        <LinearLayout
            android:id="@+id/icon_cell_default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/icon_preview_default"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_icon_default"
                android:padding="5dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/app_icon_default"
                android:textColor="?attr/textColor"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/icon_cell_midnight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/icon_preview_midnight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_icon_midnight"
                android:padding="5dp"
                android:src="@mipmap/ic_launcher_midnight" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/app_icon_midnight"
                android:textColor="?attr/textColor"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/icon_cell_inverse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/icon_preview_inverse"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_icon_inverse"
                android:padding="5dp"
                android:src="@mipmap/ic_launcher_inverse" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/app_icon_inverse"
                android:textColor="?attr/textColor"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/icon_cell_crimson"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/icon_preview_crimson"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_icon_crimson"
                android:padding="5dp"
                android:src="@mipmap/ic_launcher_crimson" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/app_icon_crimson"
                android:textColor="?attr/textColor"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/icon_cell_carbon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/icon_preview_carbon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_icon_carbon"
                android:padding="5dp"
                android:src="@mipmap/ic_launcher_carbon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/app_icon_carbon"
                android:textColor="?attr/textColor"
                android:textSize="14sp" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>
