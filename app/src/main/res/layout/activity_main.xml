<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
    android:paddingTop="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/nav_rail_view"
            android:layout_width="@dimen/nav_rail_view_width"
            android:layout_height="match_parent"
            android:background="?attr/primaryGrayBackground"
            android:descendantFocusability="afterDescendants"
            app:itemIconTint="@color/item_select_color"
            app:itemTextColor="@color/item_select_color"
            app:headerLayout="@layout/rail_header"
            app:labelVisibilityMode="unlabeled"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:menu="@menu/bottom_nav_menu"
            app:menuGravity="center">

            <include layout="@layout/rail_footer"/>

        </com.google.android.material.navigationrail.NavigationRailView>
        <!-- Phase 8.94: the floating pill nav is GONE (his
             verdict: "sucks", and community comments called it
             the worst nav). The bar is a FLAT full-width bottom
             bar: flush to the screen edges and bottom, no
             margins, no rounded pill, no elevation, every item
             labelled. Background is bg_nav_bar (near-black +
             hairline top divider); the active item gets a
             small red indicator pill behind its icon
             (NavActiveIndicator) while icon + label stay
             white/grey via item_select_color. Same view id,
             same menu, same destinations — presentation only.
             Bar height is unchanged (@dimen/nav_view_height,
             70dp); only the pill's 18dp bottom margin went
             away, so the nav zone shrank 88dp -> 70dp and the
             main-tab screens' bottom paddings dropped by the
             same 18dp (fragment_home/library/downloads/search,
             main_settings, fragment_feed).
             Phase 8.95 (nav polish v2): phone bar height is now
             @dimen/nav_view_height_phone = 80dp, the Material 3
             standard for icon+label mode — at 70dp the labels
             were clipped at the bottom on device. The nav zone
             is 80dp and the main-tab screens' compensations went
             UP by the same 10dp (their air gaps are unchanged).
             The indicator pill is now the dark-grey tonal
             @color/extButtonBackground (NavActiveIndicator) —
             red stays Play-only. On API 30+ the bar additionally
             grows by the system-bar bottom inset and pads its
             content above it (fixSystemBarsPadding in
             MainActivity, fed the same phone dimen), so the
             labels can never slide under the gesture area; the
             TV layout keeps the 70dp dimen and is untouched. -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/nav_view"
            android:layout_height="@dimen/nav_view_height_phone"
            android:layout_width="0dp"
            app:labelVisibilityMode="labeled"
            android:background="@drawable/bg_nav_bar"
            android:elevation="0dp"

            app:itemIconSize="24dp"
            app:itemActiveIndicatorStyle="@style/NavActiveIndicator"
            app:itemIconTint="@color/item_select_color"
            app:itemTextColor="@color/item_select_color"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:menu="@menu/bottom_nav_menu" />

        <!-- Phase 7.5 FIX-5: the NavHost extends to the parent's bottom so
             fragment content flows UNDERNEATH the bottom nav instead
             of stopping above it (the old chain navHost -> cast holder ->
             nav_view reserved a layout slab for the bar, which read as an
             opaque black band attached to the pill). The cast holder keeps
             its bottom chained to the top of nav_view, so the mini controller
             keeps its exact on-screen position above the bar. Main tab
             screens compensate with bottom padding on their scrolling lists
             (see fragment_home/library/downloads/search, main_settings). -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/nav_rail_view"
            app:layout_constraintTop_toTopOf="parent"
            app:navGraph="@navigation/mobile_navigation" />

        <LinearLayout
            android:id="@+id/cast_mini_controller_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/nav_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/nav_rail_view"
            tools:layout_height="100dp">
            <!--com.google.android.gms.cast.framework.media.widget.MiniControllerFragment-->
            <fragment
                android:id="@+id/cast_mini_controller"
                class="com.lagradost.cloudstream3.ui.MyMiniControllerFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"

                app:castControlButtons="@array/cast_mini_controller_control_buttons"
                app:customCastBackgroundColor="?attr/primaryGrayBackground"
                tools:ignore="FragmentTagUsage" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>