<?xml version="1.0" encoding="utf-8"?>
<!-- 8.81: Stremio Discover tab — add-by-URL plus the Cinemeta
     quick-install card. No catalog: discovery stays link-based,
     exactly like the page worked before the tabs. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stremio_discover_hint"
            android:textAppearance="?attr/textAppearanceBody2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stremio_discover_add_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stremio_add_addon"
            android:textColor="@color/white"
            app:backgroundTint="@color/extButtonBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/stremio_quick_title"
            android:textAppearance="?attr/textAppearanceSubtitle1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_repository_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stremio_quick_cinemeta_name"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stremio_quick_cinemeta_desc"
                    android:textAppearance="?attr/textAppearanceCaption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stremio_quick_install_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/stremio_quick_install"
                android:textColor="@color/white"
                app:backgroundTint="@color/extButtonBackground" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
