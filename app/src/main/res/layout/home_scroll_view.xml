<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 7.5 FIX-2 made the hero page an inset rounded CARD (margins
     16dp sides / 14dp top / 108dp bottom, bg_details_backdrop +
     clipToOutline + 6dp elevation), and Phase 8.5A restored exactly that
     after the carousel experiment. Phase 8.6 removed the card framing —
     the hero is attached: the image fills the whole 500dp pager frame
     edge-to-edge (no margins, no rounded background, no clip, no
     elevation), like the Phase 6 hero he praised; the title/meta block
     kept its old on-screen position via a 124dp bottom margin.
     Phase 8.8: user verdict — the title and "lots of other things" over
     the photo go away so the photo view is CLEAR. The whole title/meta
     block below is now visibility=gone (views kept in the layout: the
     generated binding and HomeScrollAdapter still reference them, and
     the adapter now keeps them gone), the obsolete 124dp margin is
     removed, and the 300dp bottom title_shadow that darkened the photo
     is deleted. The photo's bottom edge is blended into the page by ONE
     fade in fragment_home_head (bg_hero_bottom_fade, 90dp, ending at
     ?attr/primaryBlackBackground) — not by any darkening in this page.
     The 150dp top shadow stays: it is the subtle shade that keeps the
     floating search icon + avatar legible over bright photos.
     bg_details_backdrop is untouched — it still backs the details card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="?attr/primaryBlackBackground"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/home_scroll_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/home_scroll_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/example_poster" />

            <View
                android:id="@+id/title_shadow_top"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_gravity="top"
                android:alpha="1"
                android:background="@drawable/background_shadow"
                android:rotation="180"
                android:visibility="visible" />

            <!-- Phase 8.8: the 300dp bottom title_shadow that used to sit
                 here is deleted — it darkened the photo's lower half.
                 The bottom-edge blend now lives solely in
                 fragment_home_head (bg_hero_bottom_fade over the pager). -->

            <!-- Quality badge on the card's top-right corner. LoadResponse
                 carries no quality value (quality only exists on
                 SearchResponse), so HomeScrollAdapter keeps this gone; it
                 appears only if a quality data source ever exists. -->
            <TextView
                android:id="@+id/home_scroll_quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_quality_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="1080p" />

            <!-- Phase 8.8: the whole title/meta block is GONE — the hero
                 photo must read clear, with nothing overlaid on it. The
                 views stay in the layout (HomeScrollViewBinding and
                 HomeScrollAdapter reference them; the adapter now keeps
                 title and meta gone on every bind), but this container's
                 visibility=gone means none of them are ever drawn, and
                 the block takes no space on the photo. The Phase 8.6
                 124dp positioning margin went with it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <!-- Logo and tags stay hidden (Phase 6A). Title + meta were
                     centered over the photo (Phase 7.5 FIX-2) until
                     Phase 8.8 hid the whole block for a clear photo. -->
                <ImageView
                    android:id="@+id/home_preview_logo"
                    android:layout_width="260dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:scaleType="fitCenter"
                    android:paddingBottom="10dp"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/home_scroll_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingBottom="4dp"
                    android:textColor="?attr/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="The Perfect Run" />
                <!--<TextView
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:id="@+id/home_season_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="5 seasons 50 episodes" />-->
                <TextView
                    android:id="@+id/home_scroll_preview_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:textColor="?attr/white"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Hello • World • Tags" />

                <!-- Meta line under the title, bound by HomeScrollAdapter:
                     "year • ★ rating • type", built only from parts that
                     exist for the item. Centered with the title. -->
                <TextView
                    android:id="@+id/home_scroll_preview_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:textColor="@color/grayTextColor"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="2026 • ★ 8.6 • Movie" />
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>

</FrameLayout>
