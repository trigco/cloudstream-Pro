<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 7.5 FIX-2 made the hero page an inset rounded CARD (margins
     16dp sides / 14dp top / 108dp bottom, bg_details_backdrop +
     clipToOutline + 6dp elevation), and Phase 8.5A restored exactly that
     after the carousel experiment. Phase 8.6: the user verdict on the
     restored build was still "the hero is FLOATING" — pixel measurement
     of his screenshot confirmed the 7.5 geometry was rendering exactly
     as specified (side margins 15.0/14.5dp vs 16dp design, title/meta
     and action row at their designed offsets), so "floating" is his
     name for the inset-card look itself: a poster hovering in a black
     frame, detached from the screen edges. The card framing is therefore
     REMOVED — the hero is attached again: the image fills the whole
     500dp pager frame edge-to-edge (no margins, no rounded background,
     no clip, no elevation), like the Phase 6 hero he praised. The
     title/meta block keeps its exact old on-screen position (bottom
     margin 124dp = the card's former 108dp bottom offset + its 16dp
     gap), so the text still sits over the image just above the
     None/Play/Info action row in fragment_home_head; that file's 220dp
     bottom scrim plus this page's own 300dp title_shadow keep the text
     and buttons readable over the image's bottom edge. bg_details_backdrop
     itself is untouched — it still backs the details-page card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="?attr/primaryBlackBackground"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/home_scroll_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/home_scroll_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/example_poster" />

            <View
                android:id="@+id/title_shadow_top"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_gravity="top"
                android:alpha="1"
                android:background="@drawable/background_shadow"
                android:rotation="180"
                android:visibility="visible" />

            <View
                android:id="@+id/title_shadow"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_gravity="bottom"
                android:background="@drawable/background_shadow" />

            <!-- Quality badge on the card's top-right corner. LoadResponse
                 carries no quality value (quality only exists on
                 SearchResponse), so HomeScrollAdapter keeps this gone; it
                 appears only if a quality data source ever exists. -->
            <TextView
                android:id="@+id/home_scroll_quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_quality_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="1080p" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="124dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Logo and tags stay hidden (Phase 6A). Title + meta are
                     centered (Phase 7.5 FIX-2). Phase 8.6: the 124dp
                     bottom margin (= the removed card's 108dp bottom
                     offset + the old 16dp gap) keeps this block at the
                     exact position it held inside the card, over the
                     now full-frame image, just above the action row. -->
                <ImageView
                    android:id="@+id/home_preview_logo"
                    android:layout_width="260dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:scaleType="fitCenter"
                    android:paddingBottom="10dp"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/home_scroll_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingBottom="4dp"
                    android:textColor="?attr/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="The Perfect Run" />
                <!--<TextView
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:id="@+id/home_season_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="5 seasons 50 episodes" />-->
                <TextView
                    android:id="@+id/home_scroll_preview_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:textColor="?attr/white"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Hello • World • Tags" />

                <!-- Meta line under the title, bound by HomeScrollAdapter:
                     "year • ★ rating • type", built only from parts that
                     exist for the item. Centered with the title. -->
                <TextView
                    android:id="@+id/home_scroll_preview_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:textColor="@color/grayTextColor"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="2026 • ★ 8.6 • Movie" />
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>

</FrameLayout>
