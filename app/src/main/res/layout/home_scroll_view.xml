<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 7.5 FIX-2: the hero page is an inset rounded CARD. Phase 7 used a
     CardView (16dp sides / 14dp top / 108dp bottom, cardElevation=0); on
     device the margins were laid out but the card was visually invisible:
     no shadow, a near-black margin moat identical to the page background,
     and fragment_home_head's full-width bottom scrim faking image
     continuation over the card's bottom edge — so it read as full-bleed.
     The card is now a plain container using the exact recipe that DID
     render on this device for the details-page backdrop card
     (result_top_holder): rounded background drawable (bg_details_backdrop,
     24dp) + clipToOutline + 6dp elevation, same margins. Title + meta are
     CENTERED in the card (user request), like the details title. The page
     root stays match_parent so the pager's paging math is unchanged; the
     108dp bottom margin keeps the card's bottom edge clear of the 100dp
     action-row holder in fragment_home_head (that file is untouched). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="?attr/primaryBlackBackground"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/home_scroll_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="108dp"
        android:background="@drawable/bg_details_backdrop"
        android:clipToOutline="true"
        android:elevation="6dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/home_scroll_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/example_poster" />

            <View
                android:id="@+id/title_shadow_top"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_gravity="top"
                android:alpha="1"
                android:background="@drawable/background_shadow"
                android:rotation="180"
                android:visibility="visible" />

            <View
                android:id="@+id/title_shadow"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_gravity="bottom"
                android:background="@drawable/background_shadow" />

            <!-- Quality badge on the card's top-right corner. LoadResponse
                 carries no quality value (quality only exists on
                 SearchResponse), so HomeScrollAdapter keeps this gone; it
                 appears only if a quality data source ever exists. -->
            <TextView
                android:id="@+id/home_scroll_quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_quality_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="1080p" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Logo and tags stay hidden (Phase 6A). Title + meta are
                     centered in the card (Phase 7.5 FIX-2). -->
                <ImageView
                    android:id="@+id/home_preview_logo"
                    android:layout_width="260dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:scaleType="fitCenter"
                    android:paddingBottom="10dp"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/home_scroll_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingBottom="4dp"
                    android:textColor="?attr/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="The Perfect Run" />
                <!--<TextView
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:id="@+id/home_season_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="5 seasons 50 episodes" />-->
                <TextView
                    android:id="@+id/home_scroll_preview_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:textColor="?attr/white"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Hello • World • Tags" />

                <!-- Meta line under the title, bound by HomeScrollAdapter:
                     "year • ★ rating • type", built only from parts that
                     exist for the item. Centered with the title. -->
                <TextView
                    android:id="@+id/home_scroll_preview_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:textColor="@color/grayTextColor"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="2026 • ★ 8.6 • Movie" />
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>

</FrameLayout>
