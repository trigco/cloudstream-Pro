<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.90: one Home-style category section of the Feed
     (his order: "ক্যাটাগরি feed এ দেখাও যেমনটা home এ হচ্ছে") —
     flat on the black page, header = title (sans-serif-medium)
     + the 34x3dp red underline + a "View All ›" pill, exactly
     the 8.84 homepage_parent treatment, over a horizontal
     poster strip. One item of the grid's ConcatAdapter,
     between the hero header and the For You cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/feed_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="34dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/colorPrimaryRed" />
        </LinearLayout>

        <TextView
            android:id="@+id/feed_row_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_view_all"
            android:contentDescription="@string/home_more_info"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="@string/home_view_all"
            android:textColor="?attr/textColor"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            app:drawableRightCompat="@drawable/ic_baseline_keyboard_arrow_right_24"
            app:drawableTint="?attr/white" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feed_row_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
