<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.83: smart provider switcher sheet (SkyStream-style).
     Title, a horizontal type-filter chip row (All + the tv-type
     chips this picker has always had), a radio RecyclerView of
     providers/custom lists with source tags, and a Close row.
     Surface = rounded_dialog on the app bottom-sheet theme, so
     no light frame can show through (same recipe as 8.82). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/switcher_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_dialog"
    android:orientation="vertical">

    <!-- Phase 8.89: standard sheet chrome (Feed Filters reference) —
         drag handle + title row with the circular close button; the
         old bottom "Close" text row is gone, the ✕ replaces it. -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_feed_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/switcher_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/switcher_select_provider"
            android:textColor="?attr/textColor"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/switcher_close_btt"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_feed_circle_button"
            android:contentDescription="@string/switcher_close"
            android:padding="9dp"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="?attr/textColor" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/switcher_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/switcher_chip_all"
                style="@style/ChipFilled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/all" />

            <include
                android:id="@+id/switcher_tvtypes_chips"
                layout="@layout/tvtypes_chips" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/switcher_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:paddingTop="2dp"
        android:paddingBottom="12dp"
        tools:listitem="@layout/home_provider_switcher_row" />

</LinearLayout>
