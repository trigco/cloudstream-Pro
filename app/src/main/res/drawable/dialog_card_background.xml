<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.89: the app-wide dialog card surface (companion to the sheet
     standard). SkyStream-style floating card: 24dp rounded corners, the
     app's card fill (?attr/boxItemBackground — #1F1F1F on the dark
     variants, adaptive under Monet) and the same 1dp theme-adaptive
     outline as dialog__window_background, so the card edge stays visible
     against the dimmed backdrop. This is the android:windowBackground of
     Theme.AlertDialog / AlertDialogCustom / DialogOverlayPlayer in both
     values/ and values-v31/styles.xml. dialog__window_background (20dp,
     pure-black fill) remains for DialogHalfFullscreen (TV preview host)
     and DialogFullscreenPlayer. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android">
    <shape android:shape="rectangle">
        <corners android:radius="24dp" />
        <solid android:color="?attr/boxItemBackground" />
        <stroke
            android:width="1dp"
            android:color="@color/white_attr_20" />
    </shape>
</inset>
