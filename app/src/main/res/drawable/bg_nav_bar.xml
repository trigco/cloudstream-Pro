<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.94: FLAT bottom-nav background, replacing the
     floating pill (bg_nav_floating). His verdict on the pill:
     "sucks" — the worst nav, per community comments too. The
     bar is now a flush full-width surface: solid near-black
     with a single 1dp hairline on TOP (white ~9%) as the only
     separation from scrolling content. No corners, no stroke
     box, no elevation shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0B0B0B" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#17FFFFFF" />
        </shape>
    </item>
</layer-list>
