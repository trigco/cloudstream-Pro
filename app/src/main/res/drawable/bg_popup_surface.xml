<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.10-C: popup-menu surface. Same recipe as the dialog surface
     (dialog__window_background): ?attr/primaryBlackBackground fill + 1dp
     theme-adaptive outline (@color/white_attr_20), with a smaller 12dp
     corner radius suited to menus. Wired as android:popupBackground in the
     app's PopupMenu style (applied via ContextThemeWrapper in
     UIHelper.popupMenuNoIcons / popupMenuNoIconsAndNoStringRes). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="?attr/primaryBlackBackground" />
    <stroke
        android:width="1dp"
        android:color="@color/white_attr_20" />
</shape>
