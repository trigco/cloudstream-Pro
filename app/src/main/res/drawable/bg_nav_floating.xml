<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 4: floating bottom-nav background (Telegram-style pill bar).
     Phase 7: rounder pill (32dp) + a subtle 1dp light stroke so the bar
     reads as a lifted, separate surface over scrolling content.
     Phase 8.85: his verdict — the pill is PURE BLACK now (was
     ?attr/primaryGrayBackground, a dark gray); the stroke stays so
     the bar still reads as separate over black content. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="32dp" />
    <solid android:color="#FF000000" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
