<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.10-C: rounded text box for dialog text fields, wired into every
     EditText through AppEditStyle (android:editTextStyle + editTextStyle in
     AppTheme). Replaces the old underline look (e.g. the Add repository
     dialog) with a filled, outlined box: ?attr/primaryGrayBackground fill,
     12dp corners, and the same theme-adaptive 1dp outline as the dialog
     surface (@color/white_attr_20 = ?attr/white at 20% alpha). While the
     field is focused the outline strengthens to full ?attr/white, mirroring
     the focused-stroke precedent in res/color/bg_details_chip_stroke.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/primaryGrayBackground" />
            <stroke
                android:width="1dp"
                android:color="?attr/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/primaryGrayBackground" />
            <stroke
                android:width="1dp"
                android:color="@color/white_attr_20" />
        </shape>
    </item>
</selector>
