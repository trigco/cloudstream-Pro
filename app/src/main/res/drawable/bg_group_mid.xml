<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.77: middle segment of a grouped card — square corners,
     outline stroke; the shared stroke with the segments above and
     below reads as a divider inside the one group card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/primaryGrayBackground" />
    <stroke
        android:width="1dp"
        android:color="@color/skyOutline" />
</shape>
