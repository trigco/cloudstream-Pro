<?xml version="1.0" encoding="utf-8"?>
<!-- 8.81: rounded-square tile behind plugin icons on the SkyStream
     page (and the language chips reuse bg_sky_chip). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/skySurface" />
    <stroke
        android:width="1dp"
        android:color="@color/skyOutline" />
    <corners android:radius="12dp" />
</shape>
