<?xml version="1.0" encoding="utf-8"?>
<!-- Netflix redesign: bottom scrim over the home hero backdrop.
     Transparent at the top, fading to the app background color (#141414) at the bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00000000"
        android:centerColor="#66141414"
        android:endColor="#FF141414"
        android:type="linear" />
</shape>
