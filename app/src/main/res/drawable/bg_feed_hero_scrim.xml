<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.85: bottom scrim for the Feed hero card — transparent
     at the top, near-opaque black at the bottom edge so the
     overlaid title + provider/type line stays legible over any
     poster. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#E6000000"
        android:startColor="#00000000"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
