<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 7: modern rounded, thick seekbar track for settings sliders.
     Colors come from theme attrs so it follows dark/light variants:
     colorControlActivated resolves to colorPrimary in this app's styles. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@android:id/background"
        android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <size android:height="8dp" />
            <solid android:color="?attr/colorControlNormal" />
        </shape>
    </item>

    <item
        android:id="@android:id/progress"
        android:gravity="center_vertical">
        <clip android:clipOrientation="horizontal">
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <size android:height="8dp" />
                <solid android:color="?attr/colorControlActivated" />
            </shape>
        </clip>
    </item>

</layer-list>
