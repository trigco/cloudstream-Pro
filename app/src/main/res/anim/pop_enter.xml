<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.13: back-navigation enter — the page underneath fades back
     in and settles to full scale on the M3 emphasized curve (no rise, so
     returning feels calmer than arriving). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:duration="200"
        android:fromAlpha="0.0"
        android:interpolator="@anim/m3_emphasized"
        android:toAlpha="1.0" />
    <scale
        android:duration="280"
        android:fromXScale="0.99"
        android:fromYScale="0.99"
        android:interpolator="@anim/m3_emphasized"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>
