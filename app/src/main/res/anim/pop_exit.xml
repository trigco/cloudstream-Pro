<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.13: back-navigation exit — the leaving page fades out while
     sliding gently down, pairing pop_enter. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:duration="180"
        android:fromAlpha="1.0"
        android:interpolator="@anim/m3_emphasized"
        android:toAlpha="0.0" />
    <translate
        android:duration="260"
        android:fromYDelta="0"
        android:interpolator="@anim/m3_emphasized"
        android:toYDelta="3%p" />
    <scale
        android:duration="260"
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:interpolator="@anim/m3_emphasized"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="0.99"
        android:toYScale="0.99" />
</set>
