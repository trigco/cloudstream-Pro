<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.13: modern page exit — quick fade out with a slight settle
     down/back, pairing enter_anim. Shared across the nav graph and the
     bottom-nav NavOptions. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:duration="160"
        android:fromAlpha="1.0"
        android:interpolator="@anim/m3_emphasized"
        android:toAlpha="0.0" />
    <translate
        android:duration="240"
        android:fromYDelta="0"
        android:interpolator="@anim/m3_emphasized"
        android:toYDelta="1.5%p" />
    <scale
        android:duration="240"
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:interpolator="@anim/m3_emphasized"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="0.99"
        android:toYScale="0.99" />
</set>
