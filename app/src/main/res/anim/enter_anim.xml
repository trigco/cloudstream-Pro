<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.13: modern page enter — fade in + gentle rise + near-full
     scale settle on the M3 emphasized curve, replacing the old linear
     0.9-scale zoom that read as static. Shared by the nav graph actions,
     MainActivity's bottom-nav NavOptions and SettingsProviders, so this
     one file modernises transitions across the whole app. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:duration="200"
        android:fromAlpha="0.0"
        android:interpolator="@anim/m3_emphasized"
        android:toAlpha="1.0" />
    <translate
        android:duration="300"
        android:fromYDelta="3%p"
        android:interpolator="@anim/m3_emphasized"
        android:toYDelta="0" />
    <scale
        android:duration="300"
        android:fromXScale="0.99"
        android:fromYScale="0.99"
        android:interpolator="@anim/m3_emphasized"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>
